  "min_amenbo": "3.1.0",
  "config": [
    { "key": "smtp_host", "label": "SMTP server (Gmail: smtp.gmail.com)", "required": true },
    { "key": "smtp_port", "label": "Port", "default": "587" },
    { "key": "smtp_user", "label": "Account (Gmail: your address)", "required": true },
    { "key": "smtp_password", "label": "Password (Gmail: an app password)", "required": true, "secret": true },
    { "key": "from", "label": "From (defaults to the account)" },
    { "key": "to", "label": "To (defaults to the account; comma-separated for several)" },
    {
      "key": "events",
      "label": "What to report",
      "type": "multi",
      "default": "task.created,task.status_changed,task.done,task.rejected",
      "options": [
        { "value": "task.created", "label": "A task was created" },
        { "value": "task.status_changed", "label": "A task's status moved" },
        { "value": "task.done", "label": "A task was finished" },
        { "value": "task.rejected", "label": "A task was decided against" },
        { "value": "task.assigned", "label": "A task was assigned" },
        { "value": "task.moved", "label": "A task moved to another project" },
        { "value": "task.deleted", "label": "A task was deleted" },
        { "value": "decision.accepted", "label": "A decision was accepted" },
        { "value": "decision.rejected", "label": "A decision was rejected" },
        { "value": "comment.added", "label": "A comment was added" },
        { "value": "comment.removed", "label": "A comment was taken back" }
      ]
    }
  ],
  "events": [
    "task.created",
    "task.status_changed",
    "task.done",
    "task.rejected",
    "task.assigned",
    "task.moved",
    "task.deleted",
    "decision.accepted",
    "decision.rejected",
    "comment.added",
    "comment.removed"
  ]
